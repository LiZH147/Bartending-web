# ------------------------------------------------------------------
# Site / SEO
# ------------------------------------------------------------------
# Canonical base URL used for metadata, sitemap, robots, and OpenGraph.
# Keep this in sync with the production domain (update after adding a custom
# domain). Falls back to https://bartending-web.vercel.app when unset.
NEXT_PUBLIC_SITE_URL="https://bartending-web.vercel.app"

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
# Two schema files ship together:
#   prisma/schema.prisma            -> SQLite (default, zero-config)
#   prisma/schema.postgresql.prisma -> PostgreSQL (production / Vercel)
# `scripts/db.mjs` picks the right one automatically from DATABASE_PROVIDER
# (or from the DATABASE_URL scheme if DATABASE_PROVIDER is unset).

# Local SQLite (works immediately; db file is created under prisma/).
DATABASE_URL="file:./dev.db"
# DATABASE_PROVIDER="sqlite"     # explicit, optional

# For PostgreSQL / Vercel (e.g. Neon, Vercel Postgres, Supabase):
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://user:password@host:5432/nightcap?schema=public"
#   - DATABASE_URL = pooled connection (runtime reads). Use the pooler URL.
#   - DIRECT_URL   = direct/non-pooled connection, required by `prisma db push`
#                    and migrations (Prisma can't run migrations over PgBouncer).
# DIRECT_URL="postgresql://user:password@host:5432/nightcap?schema=public"

# ------------------------------------------------------------------
# AI / LLM (OpenAI-compatible). OPTIONAL.
# ------------------------------------------------------------------
# The app works fully WITHOUT this key using deterministic fallbacks.
# Setting a key enables: natural-language parsing, substitution, and
# creative generation via the LLM. Never expose this in the browser.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Optional: custom base URL for OpenAI-compatible providers (e.g. Azure, OpenRouter, local Ollama).
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Optional AI photograph generation for AI-created cocktails (OFF by default).
# Enable with AI_IMAGE_ENABLED="true". If the image provider differs from the chat
# LLM (common with third-party relays), set AI_IMAGE_API_KEY / AI_IMAGE_BASE_URL
# / AI_IMAGE_MODEL; otherwise it falls back to OPENAI_API_KEY / OPENAI_BASE_URL.
# Images are generated lazily on the detail page and cached, so recommendation
# results stay instant.
# AI_IMAGE_ENABLED="true"
# AI_IMAGE_API_KEY=""
# AI_IMAGE_BASE_URL=""
# AI_IMAGE_MODEL="gpt-image-1"

# ------------------------------------------------------------------
# Recommendation scoring weights (configurable, 0..1, must sum to 1.0)
# ------------------------------------------------------------------
SCORE_WEIGHT_INGREDIENT="0.40"
SCORE_WEIGHT_PREFERENCE="0.20"
SCORE_WEIGHT_DIFFICULTY="0.15"
SCORE_WEIGHT_POPULARITY="0.15"
SCORE_WEIGHT_NOVELTY="0.10"

# Minimum number of insufficient classic results before AI creative kicks in.
CREATIVE_MIN_RESULTS="3"