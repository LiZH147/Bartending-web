{
  "name": "nightcap",
  "version": "0.1.0",
  "private": true,
  "description": "AI Cocktail Recommendation — what can I mix tonight?",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "node scripts/db.mjs generate",
    "db:push": "node scripts/db.mjs db push",
    "db:migrate": "node scripts/db.mjs migrate dev",
    "db:deploy": "node scripts/db.mjs migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "node scripts/db.mjs studio",
    "postinstall": "node scripts/db.mjs generate",
    "setup": "pnpm db:push && pnpm db:seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.5.0",
    "@radix-ui/react-slot": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "15.5.27",
    "openai": "^4.89.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "prisma": "6.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}